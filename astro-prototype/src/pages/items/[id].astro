---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Chip from '../../components/Chip.astro';
import { getCollection, render } from 'astro:content';
import { graph } from '../../lib/graph.mjs';
import { refs, TYPES } from '../../lib/hubindex.mjs';
export async function getStaticPaths() {
  const items = await getCollection('items');
  return items.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const g = graph();
const id = entry.id;
const it = g.byId[id];
const { Content } = await render(entry);
const LABEL = { type: 'Loại', rank: 'Thứ hạng', evidence: 'Bằng chứng', serves: 'Phục vụ nhu cầu', metric: 'Metric', tests: 'Kiểm chứng hypothesis',
  follows: 'Theo principle', pulls_against: 'Đi ngược principle', measures: 'Đo metric', status: 'Trạng thái', baseline: 'Mức hiện tại (baseline)',
  measured_by: 'Đo bằng', participants: 'Số người tham gia', participants_type: 'Loại người tham gia', result: 'Kết quả' };
const BACK = { serves: 'Được phục vụ bởi hypothesis', metric: 'Được dùng làm metric của', tests: 'Được kiểm chứng bởi', measures: 'Được đo bởi',
  follows: 'Được theo bởi decision', pulls_against: 'Bị đi ngược bởi decision' };
const REL = ['serves', 'metric', 'tests', 'measures', 'follows', 'pulls_against'];
const rows = Object.entries(entry.data).filter(([k]) => k !== 'title');
const back = {};
(g.back[id] ?? []).forEach((b) => (back[b.label] ||= []).push(b.from));
const chains = g.paths(id).slice(0, 3);
const arts = g.artFor[id] ?? [];
const warns = g.warn[id] ?? [];
const t = TYPES.find((x) => x.letter === it.letter);
---
<StarlightPage frontmatter={{ title: `${id}: ${entry.data.title}`, description: `${t.one} · ${t.en}` }}>
  {warns.map((w) => <aside class="starlight-aside starlight-aside--caution"><p class="starlight-aside__title">Cần xem lại</p><div class="starlight-aside__content">{w}</div></aside>)}
  {it.letter !== 'O' && chains.length > 0 && (
    <p class="muted">Từ nhu cầu đến mục này:
      {chains.map((c) => (<span style="display:block">{c.map((x, i) => (<>{i > 0 && ' › '}<Chip id={x} /></>))}</span>))}
    </p>
  )}
  <table>
    <tbody>
      {rows.map(([k, v]) => (
        <tr>
          <th scope="row">{LABEL[k] ?? k}</th>
          <td>
            {REL.includes(k)
              ? (refs(v).length ? refs(v).map((x) => <Chip id={x} />) : '—')
              : k === 'type' ? t.one : String(v)}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
  <Content />
  {Object.keys(back).length > 0 && (
    <>
      <h2>Những mục nối tới mục này</h2>
      {Object.entries(back).map(([label, from]) => (<p><span class="muted">{BACK[label] ?? label}:</span> {from.map((x) => <Chip id={x} />)}</p>))}
    </>
  )}
  {arts.length > 0 && (<><h2>Tài liệu liên quan</h2><p>{arts.map((a) => <Chip id={a} />)}</p></>)}
</StarlightPage>
