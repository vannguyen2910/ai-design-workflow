---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Chip from '../components/Chip.astro';
import { graph } from '../lib/graph.mjs';
import { TYPES, STAGES, ART_TYPES, withBase } from '../lib/hubindex.mjs';
const g = graph();
const { idx } = g;
const AGREE = { agreed: 'Đã thống nhất', pending: 'Đang chờ thống nhất', 'not available': 'Chưa có cơ hội thống nhất' };
const STATUS = { open: 'Đang mở', passed: 'Đạt', failed: 'Chưa đạt' };
const counts = { O: g.O.length, H: g.H.length, M: g.M.length, D: g.D.length, T: g.T.length };
const alignment = g.D.map((d) => {
  const hs = g.tests[d];
  const os = [...new Set(hs.flatMap((h) => g.serves[h]))];
  const ts = [...new Set(hs.flatMap((h) => g.testsOf(h)))];
  return { d, hs, os, ts };
});
const grouped = [...STAGES, ''].map((s) => ({ s, list: idx.artifacts.filter((a) => a.stage === s) })).filter((x) => x.list.length);
---
<StarlightPage frontmatter={{ title: idx.caseName, description: 'Hub overview', tableOfContents: false }}>
  <p class="muted">Trạng thái thống nhất với product và business: <strong>{AGREE[idx.agreement.toLowerCase()] ?? (idx.agreement || 'chưa ghi')}</strong></p>

  <div class="cards">
    {TYPES.map((t) => (<div><span class="num">{counts[t.letter]}</span><small>{t.one}</small><small>{t.en}</small></div>))}
    <div><span class="num">{g.warnings.length} ⚠</span><small>Warnings</small></div>
  </div>

  <h2>Gates</h2>
  <div class="gates">
    {idx.gates.map((gt) => (
      <div>
        <small class="muted">{gt.name.split('(')[0].trim()}</small><br />
        <strong>{gt.name.includes('(') ? gt.name.split('(').pop().replace(')', '') : ''}</strong>
        <div class="bar"><i style={`width:${gt.total ? Math.round((100 * gt.passed) / gt.total) : 0}%`}></i></div>
        <small>{STATUS[gt.status]} · {gt.passed} trên {gt.total} mục đã đạt</small>
      </div>
    ))}
  </div>

  <h2>Tài liệu theo giai đoạn</h2>
  {grouped.map((x) => (
    <p><strong>{x.s || 'Khác'}</strong><br />
      {x.list.map((a) => (<a class="chip t-A" href={withBase(`/docs/${a.id}/`)} title={a.summary}>{ART_TYPES[a.type] ?? a.type}: {a.title}</a>))}
    </p>
  ))}

  <h2>Mỗi decision dựa trên nhu cầu nào?</h2>
  <table>
    <thead><tr><th>Decision</th><th>Kiểm chứng hypothesis</th><th>Phục vụ nhu cầu</th><th>Test</th><th>Theo principle</th><th>Đi ngược</th></tr></thead>
    <tbody>
      {alignment.map((r) => (
        <tr>
          <td><Chip id={r.d} /> {g.byId[r.d].title}</td>
          <td>{r.hs.length ? r.hs.map((h) => <Chip id={h} />) : <em>chưa có</em>}</td>
          <td>{r.os.length ? r.os.map((o) => <Chip id={o} />) : <em>chưa có</em>}</td>
          <td>{r.ts.length ? r.ts.map((t) => <Chip id={t} />) : <em>chưa có</em>}</td>
          <td>{g.follows[r.d].length ? g.follows[r.d].map((p) => <Chip id={p} />) : '—'}</td>
          <td>{g.strains[r.d].length ? g.strains[r.d].map((p) => <Chip id={p} />) : '—'}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2>Warnings</h2>
  <p class="muted">Đây không phải lỗi. Mỗi điểm là chỗ cần một decision rõ ràng: sửa, giữ lại có chủ đích, hoặc bỏ đi.</p>
  <ul class="warnlist">
    {g.warnings.map((w) => (<li>⚠ {w.ids.map((i) => <Chip id={i} />)} <strong>{w.text}</strong></li>))}
  </ul>
</StarlightPage>
