---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { graph } from '../../lib/graph.mjs';
import { STAGES, ART_TYPES, ART_STATUS, withBase } from '../../lib/hubindex.mjs';
const { idx } = graph();
const groups = [...STAGES, ''].map((s) => ({ s, list: idx.artifacts.filter((a) => a.stage === s) })).filter((x) => x.list.length);
---
<StarlightPage frontmatter={{ title: 'Tài liệu', description: 'Các sản phẩm làm ra trong dự án', tableOfContents: false }}>
  <p>Mỗi tài liệu có trang riêng, kèm hình, prototype chạy được, link ngoài và các item nó hỗ trợ.</p>
  {groups.map((x) => (
    <>
      <h2>{x.s || 'Khác'}</h2>
      <div class="cards">
        {x.list.map((a) => (
          <div>
            <small class="muted">{ART_TYPES[a.type] ?? a.type}</small>
            <strong><a href={withBase(`/docs/${a.id}/`)}>{a.title}</a></strong>
            <small>{a.summary}</small>
            {a.status && <small>{ART_STATUS[a.status]}</small>}
          </div>
        ))}
      </div>
    </>
  ))}
</StarlightPage>
