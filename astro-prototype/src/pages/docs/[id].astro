---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Chip from '../../components/Chip.astro';
import path from 'node:path';
import { getCollection, getEntry, render } from 'astro:content';
import { graph } from '../../lib/graph.mjs';
import { CASE, ART_TYPES, ART_STATUS, assetUrl, mediaOf } from '../../lib/hubindex.mjs';
export async function getStaticPaths() {
  const arts = await getCollection('artifacts');
  return arts.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const g = graph();
const a = g.idx.artifacts.find((x) => x.id === entry.id);
const own = entry.body?.replace(/^\s*#\s+.*\n/, '').trim() ? await render(entry) : null;
let src = null;
if (a.source) {
  const abs = path.resolve(path.dirname(a.abs), a.source);
  const id = path.relative(CASE, abs).replace(/\\/g, '/').replace(/\.md$/, '');
  const se = await getEntry('sources', id);
  if (se) src = await render(se);
}
const media = mediaOf(a);
const WARN = { simulated: 'kết quả đến từ người mô phỏng, không phải người dùng thật.', draft: 'nội dung chưa được kiểm tra.', planned: 'mới ở dạng kế hoạch, chưa thực hiện.' };
const host = (u) => { try { return new URL(u).host.replace('www.', ''); } catch { return 'Link'; } };
---
<StarlightPage frontmatter={{ title: a.title, description: a.summary }}>
  <p>
    <span class="muted">{ART_TYPES[a.type] ?? a.type}{a.stage ? ' · ' + a.stage : ''}</span>
    {a.status && <span class="chip t-A">{ART_STATUS[a.status] ?? a.status}</span>}
  </p>
  {WARN[a.status] && <aside class="starlight-aside starlight-aside--caution"><p class="starlight-aside__title">Trạng thái: {ART_STATUS[a.status]}</p><div class="starlight-aside__content">Tài liệu này {WARN[a.status]}</div></aside>}
  {a.supports.length > 0 && <p><span class="muted">Hỗ trợ:</span> {a.supports.map((s) => <Chip id={s} />)}</p>}
  {a.takeaways.length > 0 && (<><h2>Điểm chính</h2><ul>{a.takeaways.map((t) => <li>{t}</li>)}</ul></>)}

  {(media.length > 0 || a.links.length > 0 || a.embedUrl) && <h2>Hình ảnh và tệp</h2>}
  {media.some((m) => m.kind === 'image') && (
    <div class="figs">
      {media.filter((m) => m.kind === 'image').map((m) => (
        <figure class="fig"><a href={assetUrl(m.abs)} target="_blank" rel="noopener"><img loading="lazy" src={assetUrl(m.abs)} alt={m.name} /></a><figcaption class="muted">{m.name}</figcaption></figure>
      ))}
    </div>
  )}
  {media.filter((m) => m.kind !== 'image').map((m) => (
    <div class="mcard">
      <div class="mhead">
        <strong>{m.name}</strong>
        <span class="muted">{m.kind === 'html' ? 'Prototype / trang HTML' : m.kind === 'pdf' ? 'PDF' : m.kind === 'doc' ? 'Tài liệu gốc' : 'Tệp đính kèm'}</span>
        <a class="btn sl-link-button primary" href={assetUrl(m.abs)} target="_blank" rel="noopener">Mở ở tab mới ↗</a>
      </div>
      {a.embed && (m.kind === 'html' || m.kind === 'pdf') && <iframe loading="lazy" src={assetUrl(m.abs)} title={m.name}></iframe>}
    </div>
  ))}
  {a.links.map((l) => { const [label, url] = l.includes('|') ? l.split('|').map((s) => s.trim()) : [host(l), l]; return (
    <div class="mcard"><div class="mhead"><strong>{label}</strong><span class="muted">{host(url)}</span><a class="btn sl-link-button primary" href={url} target="_blank" rel="noopener">Mở link ↗</a></div></div>
  ); })}
  {a.embedUrl && <div class="mcard"><iframe loading="lazy" src={a.embedUrl} title={a.title} allowfullscreen></iframe></div>}

  {own && <own.Content />}
  {src && (<>{own && <h2>Nội dung đầy đủ</h2>}<src.Content /></>)}
  {a.source && <p class="muted">Nguồn: <code>{a.source}</code></p>}
</StarlightPage>
